--- !u!114 &7396589126988890363
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5319923277532203252}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#7CFFB0>\u2713</color> Clean Sector\r\n<size=34><color=#AAB8CC>Finish
    a timed wave without taking damage.</color></size>\r\n\r\n<color=#7CFFB0>\u2713</color>
    Drift Survivor\r\n<size=34><color=#AAB8CC>Complete wave 10 or higher in a single
    run.</color></size>\r\n\r\n\u25CB Aces High  (0/40)\r\n<size=34><color=#AAB8CC>Destroy
    40 hostile craft across all runs.</color></size>\r\n\r\n<color=#7CFFB0>\u2713</color>
    Belt Breaker\r\n<size=34><color=#AAB8CC>Destroy 500 asteroids across all runs.</color></size>\r\n\r\n<color=#7CFFB0>\u2713</color>
    Chain Reaction\r\n<size=34><color=#AAB8CC>Destroy 3 asteroids within 2 seconds.</color></size>\r\n\r\n<color=#7CFFB0>\u2713</color>
    1,000 Asteroids\r\n<size=34><color=#AAB8CC>Destroy 1000 asteroids across all
    runs.</color></size>\r\n\r\n<color=#7CFFB0>\u2713</color> 1,500 Asteroids\r\n<size=34><color=#AAB8CC>Destroy
    1500 asteroids across all runs.</color></size>\r\n\r\n\u25CB Family Ties\r\n<size=34><color=#AAB8CC>Hold
    6+ upgrade stacks in one of Volt, Kinetic, Thermal, or Static in a single run.</color></size>\r\n\r\n\u25CB
    Quad Core\r\n<size=34><color=#AAB8CC>Have Volt, Kinetic, Thermal, and Static
    all present in your loadout at once.</color></size>\r\n\r\n<color=#7CFFB0>\u2713</color>
    Volley Storm\r\n<size=34><color=#AAB8CC>Reach the maximum volley spread (4 shots)
    in a single run.</color></size>\r\n\r\n<color=#7CFFB0>\u2713</color> Full Deck\r\n<size=34><color=#AAB8CC>Fill
    all 4 loadout slots in a single run.</color></size>\r\n\r\n<color=#7CFFB0>\u2713</color>
    Deep Run\r\n<size=34><color=#AAB8CC>Complete wave 15 or higher in a single run.</color></size>\r\n\r\n\u25CB
    Sector Record  (0/5)\r\n<size=34><color=#AAB8CC>Set a new personal best score
    5 times.</color></size>\r\n\r\n<color=#7CFFB0>\u2713</color> Wave 20\r\n<size=34><color=#AAB8CC>Complete
    wave 20 or higher in a single run.</color></size>\r\n\r\n<color=#7CFFB0>\u2713</color>
    Wrapped\r\n<size=34><color=#AAB8CC>Destroy 25 asteroids while flying near the
    screen edge.</color></size>\r\n\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: a6d2293a7f4577a46bb57bbde9b46712, type: 2}
